{
  "name": "typed-release-planner",
  "version": "1.0.0",
  "description": "A strict TypeScript CLI that turns feature ideas into a risk-aware release plan.",
  "type": "module",
  "bin": {
    "release-plan": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js examples/roadmap.json",
    "test": "node --test dist/test/*.test.js",
    "check": "npm run build && npm test"
  },
  "keywords": [
    "typescript",
    "cli",
    "planning",
    "strict-types",
    "release-management"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
